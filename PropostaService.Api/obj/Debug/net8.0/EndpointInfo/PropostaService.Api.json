{
  "openapi": "3.0.1",
  "info": {
    "title": "PropostaService.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/Propostas": {
      "post": {
        "tags": [
          "Propostas"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarPropostaRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarPropostaRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CriarPropostaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Propostas"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Propostas/{id}": {
      "get": {
        "tags": [
          "Propostas"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Propostas/{id}/status": {
      "patch": {
        "tags": [
          "Propostas"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlterarStatusRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AlterarStatusRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AlterarStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlterarStatusRequest": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/StatusProposta"
          }
        },
        "additionalProperties": false
      },
      "CriarPropostaRequest": {
        "type": "object",
        "properties": {
          "nomeCliente": {
            "type": "string",
            "nullable": true
          },
          "tipoSeguro": {
            "type": "string",
            "nullable": true
          },
          "valor": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "StatusProposta": {
        "enum": [
          "EmAnalise",
          "Aprovada",
          "Rejeitada"
        ],
        "type": "string"
      }
    }
  }
}